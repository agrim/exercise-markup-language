{
  "eml": "1.1",
  "id": "personal-paused-squat",
  "title": "Personal Paused Squat",
  "instructions": "Keep the heels and forefeet planted. Lower, pause, and return to standing.",
  "start": {"pose": "standing"},
  "parameters": {"depth": {"default": 0.72, "min": 0.4, "max": 1}},
  "phases": [
    {"id": "lower", "seconds": 1.4, "actions": [{"use": "squat-down", "amount": {"param": "depth"}}]},
    {"id": "pause", "seconds": 0.4, "actions": [{"use": "squat-down", "amount": {"param": "depth"}}]},
    {"id": "stand", "seconds": 1.3, "actions": []}
  ],
  "constraints": [
    {"kind": "support", "landmark": "leftHeel", "surface": "floor", "min": -0.004, "max": 0.012},
    {"kind": "support", "landmark": "rightHeel", "surface": "floor", "min": -0.004, "max": 0.012}
  ],
  "muscles": {"primary": ["quadriceps", "glutes"], "secondary": ["hamstrings"]},
  "repeat": {"mode": "loop", "count": 3}
}
