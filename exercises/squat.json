{
  "eml": "1.1",
  "id": "squat",
  "title": "Squat",
  "instructions": "Rest the bar across the upper back. Bend the hips and knees together, keep pressure through both feet, then stand.",
  "start": {
    "pose": "lower-back-rack", "root": [0, -0.025, 0],
    "stance": {
      "width": {
        "param": "stance-width-m"
      },
      "toeOut": {
        "param": "toe-out-deg"
      }
    },
    "joints": {"bothThigh": {"y": {"param": "toe-out-deg"}}}
  },
  "equipment": [
    {
      "id": "bar",
      "kind": "barbell",
      "follow": {
        "joint": "chest",
        "offset": [
          0,
          0.275,
          -0.083
        ]
      }
    },
    {
      "id": "rack",
      "kind": "squat-rack",
      "position": [
        0,
        0,
        -0.48
      ]
    }
  ],
  "contacts": [
    {
      "effector": "leftBall",
      "target": "floor"
    },
    {
      "effector": "rightBall",
      "target": "floor"
    },
    {
      "effector": "leftGrip",
      "target": {
        "item": "bar",
        "socket": "leftGrip"
      }
    },
    {
      "effector": "rightGrip",
      "target": {
        "item": "bar",
        "socket": "rightGrip"
      }
    }
  ],
  "phases": [
    {
      "id": "descend",
      "seconds": 1.7,
      "actions": [
        {
          "use": "squat-down",
          "amount": {
            "param": "depth"
          }
        },
        {"use": "lower-track-squat-stance", "amount": {"param": "stance-width-m"}}
      ]
    },
    {
      "id": "stand",
      "seconds": 1.7,
      "actions": []
    }
  ],
  "repeat": {
    "mode": "loop",
    "count": 1
  },
  "muscles": {
    "primary": [
      "quadriceps",
      "glutes"
    ],
    "secondary": [
      "hamstrings",
      "abdominals",
      "obliques"
    ]
  },
  "camera": [
    44,
    10
  ],
  "parameters": {
    "stance-width-m": {
      "min": 0.21,
      "max": 0.49,
      "default": 0.35
    },
    "toe-out-deg": {
      "min": 0,
      "max": 23,
      "default": 12
    },
    "depth": {
      "min": 0.55,
      "max": 1.12,
      "default": 1
    }
  }
}
