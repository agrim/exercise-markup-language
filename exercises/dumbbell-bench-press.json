    {
      "id": "lower",
      "seconds": 0.8,
      "actions": [],
      "ease": "ease-out"
    }
  ],
  "repeat": {"mode": "loop", "count": 1},
  "muscles": {"primary": ["pectorals", "upperPectorals"], "secondary": ["triceps", "anteriorDeltoids"]},
